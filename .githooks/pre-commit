#!/usr/bin/env python3
"""提交前檢查:這次提交動到 .claude/skills 或 .agents/skills 時,.claude/skills 底下每一支 Skill 都要通過 form 系列的檢查。

啟用(每個 clone 做一次):git config core.hooksPath .githooks
臨時略過一次:git commit --no-verify
檢查的是工作目錄裡的檔,不是 index 裡的。
"""
import json
import subprocess
import sys
from pathlib import Path


def git(*arguments: str) -> str:
    return subprocess.run(["git", *arguments], capture_output=True, text=True, encoding="utf-8").stdout


def main() -> int:
    root = Path(git("rev-parse", "--show-toplevel").strip())
    staged = git("diff", "--cached", "--name-only", "-z").split("\0")
    if not any(path.startswith((".claude/skills/", ".agents/skills/")) for path in staged):
        return 0

    checker = root / ".claude" / "skills" / "skill-conform" / "scripts" / "check_skills.py"
    try:
        done = subprocess.run(
            ["uv", "run", "--quiet", str(checker), "--skills", str(root / ".claude" / "skills")],
            capture_output=True,
            text=True,
            encoding="utf-8",
        )
    except FileNotFoundError:
        print("pre-commit: 找不到 uv,這次沒有檢查 Skill。", file=sys.stderr)
        return 0
    if done.returncode == 0:
        return 0
    if done.returncode != 1:
        print(f"pre-commit: 檢查腳本沒有跑完(exit code {done.returncode}),這次沒有檢查 Skill。\n{done.stderr.strip()[-600:]}", file=sys.stderr)
        return 0

    report = json.loads(done.stdout)
    summary = report["summary"]
    print(f"提交被擋下:{summary['failed_skills']} 支 Skill 有 {summary['items']} 項不符合 form 系列的規範", file=sys.stderr)
    for skill in report["skills"]:
        for item in skill["items"]:
            where = item["file"] + (f" 第 {item['line']} 行" if item["line"] else "")
            print(f"  {skill['skill']}  {item['part']}〈{item['rule']}〉{where}: {item['reason']}", file=sys.stderr)
    print(
        "處理方式:用 skill-conform 處理,或逐項修正後再提交。只是流程視覺圖不一致的話執行\n"
        "  uv run .claude/skills/skill-conform/scripts/check_skills.py --skills .claude/skills --only <Skill 名稱> --write-diagrams\n"
        "臨時略過一次:git commit --no-verify",
        file=sys.stderr,
    )
    return 1


if __name__ == "__main__":
    sys.exit(main())
